# Environment variable NAMES only. Never put a real secret in this file
# (specification Section 5, 20.4).
#
# Only the ingestion service reads these today. The calculation engine in
# model/ reads no environment at all -- its inputs are files, and a run is a
# pure function of them.

# --- ingestion (apps/api/app/core/config.py) --------------------------------

# Where uploaded PDFs are stored, write-once and content-addressed (1.12).
# Required: the service will not choose a directory for evidence.
INGEST_STORAGE_ROOT=./var/sources

# Upload limits (20.8). Defaults are 64 MiB and 1000 pages, set above what a
# 10-K with exhibits normally needs rather than at it.
INGEST_MAX_BYTES=67108864
INGEST_MAX_PAGES=1000

# A page whose text layer yields fewer characters than this is treated as
# having no text layer, and decision 2.3.c then refuses the document.
INGEST_MIN_CHARS_FOR_TEXT_NATIVE=32

# Facts scoring below this go to manual review (10.29). The score is the
# fraction of eight named evidence conditions a fact satisfies, so 0.875 means
# "at most one piece of evidence may be missing". Read as a decimal string,
# never a float (4.2).
INGEST_REVIEW_THRESHOLD=0.875

# --- not yet used -----------------------------------------------------------
# PostgreSQL (3.2.d) and object storage (3.2.e) are Phase 15/17. Records are
# written to JSON files under INGEST_STORAGE_ROOT/records today; the repository
# protocol in apps/api/app/persistence/json_store.py is what a database
# implementation replaces.
# DATABASE_URL=

# --- the review application (apps/api/app/security/) ------------------------

# 2.2.c requires a credential in front of the hosted deployment. Produce the
# value with `python3 -m apps.api.app.security.credentials`, which prompts for
# the password and prints the scrypt hash. NEVER put the password itself here:
# an environment variable is visible in every process listing on the host.
REVIEW_PASSWORD_HASH=

# Signs session cookies. `python3 -m apps.api.app.security.credentials --key`.
# Rotating this invalidates every existing session immediately, which is the
# revocation mechanism -- see docs/incident-response.md 4.1.
REVIEW_SECRET_KEY=

# 20.9's scanner, run over every upload before anything parses it. The contract
# is the one every scanner implements: the file path as the single argument,
# exit 0 for clean. With this unset, uploads are recorded as NOT SCANNED --
# which is never reported as clean.
INGEST_SCAN_COMMAND=
